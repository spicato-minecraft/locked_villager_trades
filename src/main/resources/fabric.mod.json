{
	"schemaVersion": 1,
	"id": "locked_villager_trades",
	"version": "${version}",
	"name": "locked_villager_trades",
	"description": "Locks villager trades to the first trade that appears for each profession. Break and replace workstations or switch professions—trades stay the same.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/locked_villager_trades/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"locked_villager_trades.Locked_villager_trades"
		],
		"client": [
			"locked_villager_trades.Locked_villager_tradesClient"
		]
	},
	"mixins": [
		"locked_villager_trades.mixins.json",
		{
			"config": "locked_villager_trades.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
